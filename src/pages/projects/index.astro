---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/Layout.astro';
import LangToggle from '~/components/LangToggle.astro';
import { categoryColor } from '~/utils/categoryColors';

const entries = await getCollection('projects');
const projects = entries
  .filter((e) => e.data.featured)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .map((e) => ({ slug: e.slug, ...e.data }));

function splitSummary(html: string) {
  const parts = [...html.matchAll(/<span[^>]*>([\s\S]*?)<\/span>/g)].map((m) => m[1].trim());
  const ko = parts.find((p) => /[가-힣]/.test(p));
  const en = parts.find((p) => p !== ko);
  return en && ko ? { en, ko } : { en: html, ko: html };
}
---

<Layout title="Projects">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <LangToggle />

    <header class="mt-6 mb-10">
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 mb-2">
        <span class="lang-en">Projects</span>
        <span class="lang-ko">프로젝트</span>
      </h1>
      <p class="text-sm text-slate-500">
        <span class="lang-en">Generative AI, 2D/3D Representation Reconstruction Research and Projects</span>
        <span class="lang-ko">생성형 AI, 2D/3D Representation Reconstruction 연구 및 프로젝트</span>
      </p>
    </header>

    <div class="flex flex-col gap-6">
      {projects.map((p) => (
        <a
          href={p.externalUrl || `/projects/${p.slug}/`}
          target={p.externalUrl ? '_blank' : undefined}
          rel={p.externalUrl ? 'noopener' : undefined}
          class="group rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden hover:shadow-md hover:border-blue-300 transition-all flex flex-col md:flex-row"
        >
          <div class="aspect-video md:aspect-auto md:w-2/5 md:min-h-[240px] shrink-0 overflow-hidden bg-white flex items-center justify-center p-3 md:border-r md:border-gray-100">
            <img src={p.thumbnail} alt="" class="w-full h-full object-contain group-hover:scale-[1.02] transition-transform duration-300" />
          </div>
          <div class="p-5 md:p-6 flex flex-col gap-3 flex-1">
            <div class="flex items-center gap-2">
              <span class="inline-block px-2 py-0.5 rounded-full bg-blue-100 text-blue-600 text-[10px] font-bold uppercase tracking-wide">{p.badge}</span>
              <span class="text-[11px] text-slate-400">
                {p.periodEn && p.periodKo ? (
                  <>
                    <span class="lang-en">{p.periodEn}</span>
                    <span class="lang-ko">{p.periodKo}</span>
                  </>
                ) : (
                  new Date(p.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short' })
                )}
              </span>
            </div>
            <h2 class="text-lg md:text-xl font-bold text-slate-900 leading-snug group-hover:text-blue-600 transition-colors">
              {p.titleKo ? (
                <>
                  <span class="lang-en">{p.title}</span>
                  <span class="lang-ko">{p.titleKo}</span>
                </>
              ) : p.title}
            </h2>
            {p.summary && (
              <>
                <div class="lang-en">
                  <p class="text-sm text-slate-500 leading-relaxed text-justify break-keep [&_br]:hidden" set:html={splitSummary(p.summary).en} />
                </div>
                <div class="lang-ko">
                  <p class="text-sm text-slate-500 leading-relaxed text-justify break-keep [&_br]:hidden" set:html={splitSummary(p.summary).ko} />
                </div>
              </>
            )}
            <div class="flex flex-wrap gap-1.5 mt-auto pt-2">
              {p.categories.map((c) => (
                <span class={`text-[10px] px-2 py-0.5 rounded-full font-medium ${categoryColor(c)}`}>{c}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
